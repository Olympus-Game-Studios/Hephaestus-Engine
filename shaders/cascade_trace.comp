#version 460
#extension GL_EXT_ray_query : require
#extension GL_EXT_buffer_reference : require
#extension GL_EXT_buffer_reference_uvec2 : require
#extension GL_GOOGLE_include_directive : require

// Traces the scheduled cascade probes and lights each ray's hit (direct light + last frame's cascades).
layout(local_size_x = 128) in;

#define GI_SET 0
#include "probe_common.glsl"
#define LIGHTING_SET 0
#define LIGHTING_BINDING 1
#include "lighting_common.glsl"
#include "probe_shading.glsl"
#define CASCADE_SET 0
#define CASCADE_SAMPLING
#include "cascade_common.glsl"

layout(set = 0, binding = 11) uniform accelerationStructureEXT sceneTlas;

struct TraceInstance {
    vec4 albedo;
    vec4 emissive;
    uvec2 vertices;  // address of Vertex[] (engine/Gfx/Vertex.h, 11 floats each)
    uvec2 indices;   // address of uint[]
};
layout(std430, set = 0, binding = 16) readonly buffer Instances { TraceInstance instances[]; };
layout(std430, set = 0, binding = 17) readonly buffer Jobs { uint jobs[]; };
layout(std430, set = 0, binding = 18) writeonly buffer Rays { vec4 rays[]; };  // rgb = radiance, a = distance

layout(buffer_reference, std430, buffer_reference_align = 4) readonly buffer Floats { float v[]; };
layout(buffer_reference, std430, buffer_reference_align = 4) readonly buffer Indices { uint i[]; };

const uint RAYS = 128u;
const uint VERTEX_FLOATS = 11u;

vec3 vertexPosition(Floats vertices, uint index) {
    uint base = index * VERTEX_FLOATS;
    return vec3(vertices.v[base], vertices.v[base + 1u], vertices.v[base + 2u]);
}

bool occluded(vec3 origin, vec3 dir) {
    rayQueryEXT q;
    rayQueryInitializeEXT(q, sceneTlas, gl_RayFlagsOpaqueEXT | gl_RayFlagsTerminateOnFirstHitEXT, 0xFF,
                          origin, 0.001, dir, 10000.0);
    while (rayQueryProceedEXT(q)) {}
    return rayQueryGetIntersectionTypeEXT(q, true) != gl_RayQueryCommittedIntersectionNoneEXT;
}

void main() {
    uint job = jobs[gl_WorkGroupID.x];
    int c = int(job >> CASCADE_SLOT_BITS);
    ivec3 slot = cascadeSlotCoord(int(job & ((1u << CASCADE_SLOT_BITS) - 1u)));
    uint ray = gl_LocalInvocationID.x;
    float spacing = cascades.spacing[c];
    vec3 origin = cascadeProbePosition(c, cascadeCellOfSlot(c, slot));
    vec3 dir = mat3(cascades.rotation) * probeRayDirection(ray, RAYS);
    float maxDistance = cascades.settings.y * spacing;

    rayQueryEXT q;
    rayQueryInitializeEXT(q, sceneTlas, gl_RayFlagsOpaqueEXT, 0xFF, origin, 0.0, dir, 10000.0);
    while (rayQueryProceedEXT(q)) {}

    vec4 result = vec4(skyRadiance(dir), maxDistance);
    if (rayQueryGetIntersectionTypeEXT(q, true) == gl_RayQueryCommittedIntersectionTriangleEXT) {
        TraceInstance inst = instances[rayQueryGetIntersectionInstanceCustomIndexEXT(q, true)];
        uint primitive = uint(rayQueryGetIntersectionPrimitiveIndexEXT(q, true));
        Indices indices = Indices(inst.indices);
        Floats vertices = Floats(inst.vertices);
        vec3 a = vertexPosition(vertices, indices.i[primitive * 3u]);
        vec3 b = vertexPosition(vertices, indices.i[primitive * 3u + 1u]);
        vec3 e = vertexPosition(vertices, indices.i[primitive * 3u + 2u]);
        mat3 objectToWorld = mat3(rayQueryGetIntersectionObjectToWorldEXT(q, true));
        vec3 n = normalize(transpose(inverse(objectToWorld)) * cross(b - a, e - a));
        float t = rayQueryGetIntersectionTEXT(q, true);
        if (dot(n, dir) > 0.0) {
            // Inside geometry: no light, and a short distance so the visibility test keeps this probe
            // from lighting the far side of the wall (DDGI, Majercik et al. 2019).
            result = vec4(0.0, 0.0, 0.0, min(t * 0.2, maxDistance));
        } else {
            vec3 hitPos = origin + dir * t;
            float sun = 1.0;
            if (lighting.dirLightDirIntensity.w > 0.0) {
                vec3 toSun = normalize(-lighting.dirLightDirIntensity.xyz);
                sun = dot(n, toSun) > 0.0 && !occluded(hitPos + n * 0.01, toSun) ? 1.0 : 0.0;
            }
            vec4 bounce = sampleCascades(hitPos, n, -dir);
            vec3 irradiance = mix(skyRadiance(n), bounce.rgb, bounce.w) * PI;
            vec3 radiance = inst.albedo.rgb / PI * (directIrradiance(hitPos, n, sun) + irradiance) + inst.emissive.rgb;
            result = vec4(radiance, min(t, maxDistance));
        }
    }
    rays[gl_WorkGroupID.x * RAYS + ray] = result;
}
