#version 450
#extension GL_GOOGLE_include_directive : require

// One workgroup per probe, one invocation per baked ray (kProbeBakeRaysPerProbe in engine/Gfx/ProbeBake.h).
layout(local_size_x = 128) in;

#define GI_SET 0
#include "probe_common.glsl"
#define LIGHTING_SET 0
#define LIGHTING_BINDING 1
#include "lighting_common.glsl"

struct RayHit {
    vec4 normalDistance;  // xyz = normal, w = distance (< 0 = sky)
    vec4 albedo;          // w = sun visibility when giParams.w = 1
    vec4 emissive;        // w = 1 when the ray hit a backface
};
layout(std430, set = 0, binding = 2) readonly buffer Rays { RayHit rays[]; };
layout(set = 0, binding = 4) uniform sampler2D sunDepth;
layout(set = 0, binding = 6, rgba16f) uniform writeonly image2D irradianceOut;
layout(set = 0, binding = 8, rg16f) uniform writeonly image2D visibilityOut;

const float PI = 3.14159265359;
const uint RAYS = 128u;

shared vec3 sRadiance[RAYS];
shared vec3 sDirection[RAYS];
shared float sDistance[RAYS];

float sunVisibility(vec3 pos) {
    if (gi.giParams.y < 0.5) {
        return 1.0;
    }
    vec4 clip = gi.sunViewProj * vec4(pos, 1.0);
    vec3 ndc = clip.xyz / clip.w;
    vec2 uv = ndc.xy * 0.5 + 0.5;
    if (any(lessThan(uv, vec2(0.0))) || any(greaterThan(uv, vec2(1.0))) || ndc.z < 0.0 || ndc.z > 1.0) {
        return 1.0;
    }
    return ndc.z - 0.002 > texture(sunDepth, uv).r ? 0.0 : 1.0;
}

vec3 skyRadiance(vec3 dir) {
    if (lighting.environmentReflectionParams.z > 0.5) {
        return evaluateSkyRadiance(dir) * lighting.environmentReflectionParams.w;
    }
    return lighting.ambientColorIntensity.rgb * lighting.ambientColorIntensity.w;
}

vec3 directIrradiance(vec3 pos, vec3 n, float tracedSunVisibility) {
    vec3 e = vec3(0.0);
    if (lighting.dirLightDirIntensity.w > 0.0) {
        vec3 l = normalize(-lighting.dirLightDirIntensity.xyz);
        float visibility = gi.giParams.w > 0.5 ? tracedSunVisibility : sunVisibility(pos + n * 0.05);
        e += lighting.dirLightColor.rgb * lighting.dirLightDirIntensity.w * max(dot(n, l), 0.0) * visibility;
    }
    for (int i = 0; i < lighting.pointLightCount && i < 16; ++i) {
        vec3 toLight = lighting.pointLightPositions[i].xyz - pos;
        float dist = length(toLight);
        if (dist > lighting.pointLightPositions[i].w) continue;
        float atten = calculateAttenuation(dist, lighting.pointLightAttenuation[i].xyz);
        e += lighting.pointLightColors[i].rgb * lighting.pointLightColors[i].w * atten *
             max(dot(n, toLight / max(dist, 1e-4)), 0.0);
    }
    for (int i = 0; i < lighting.spotLightCount && i < 16; ++i) {
        vec3 toLight = lighting.spotLightPositions[i].xyz - pos;
        float dist = length(toLight);
        if (dist > lighting.spotLightPositions[i].w) continue;
        vec3 l = toLight / max(dist, 1e-4);
        float cone = calculateSpotlightFalloff(lighting.spotLightDirections[i].xyz, -l,
                                               lighting.spotLightDirections[i].w,
                                               lighting.spotLightAttenuation[i].w);
        if (cone <= 0.0) continue;
        float atten = calculateAttenuation(dist, lighting.spotLightAttenuation[i].xyz);
        e += lighting.spotLightColors[i].rgb * lighting.spotLightColors[i].w * atten * cone * max(dot(n, l), 0.0);
    }
    return e;
}

vec3 texelDirection(ivec2 local, int inner) {
    // Border texels (0 and inner + 1) take the direction just across the octahedral fold.
    vec2 uv = (vec2(local) - 0.5) / float(inner) * 2.0 - 1.0;
    if (abs(uv.x) > 1.0) {
        uv.x = sign(uv.x) * 2.0 - uv.x;
        uv.y = -uv.y;
    }
    if (abs(uv.y) > 1.0) {
        uv.y = sign(uv.y) * 2.0 - uv.y;
        uv.x = -uv.x;
    }
    return octDecode(uv);
}

void main() {
    // One workgroup per atlas tile (engine/Gfx/ProbeGI.cpp:createAtlases); the last row may be partly empty.
    int probe = int(gl_WorkGroupID.y * gi.atlasTiles.x + gl_WorkGroupID.x);
    if (probe >= gi.probeCounts.x * gi.probeCounts.y * gi.probeCounts.z) return;
    uint ray = gl_LocalInvocationID.x;
    vec3 probePos = probePosition(probe);
    float maxDistance = gi.giParams.x;

    RayHit hit = rays[uint(probe) * RAYS + ray];
    vec3 dir = mat3(gi.rayRotation) * probeRayDirection(ray, RAYS);
    vec3 radiance;
    float distance;
    if (hit.normalDistance.w < 0.0) {
        radiance = skyRadiance(dir);
        distance = maxDistance;
    } else if (hit.emissive.w > 0.5) {
        // Inside geometry: no light, and a short distance so the visibility test stops this probe
        // from lighting surfaces on the far side of the wall (DDGI, Majercik et al. 2019).
        radiance = vec3(0.0);
        distance = hit.normalDistance.w * 0.2;
    } else {
        distance = hit.normalDistance.w;
        vec3 n = hit.normalDistance.xyz;
        vec3 hitPos = probePos + dir * distance;
        vec3 bounce = gi.giParams.z > 0.5 ? vec3(0.0) : sampleProbeIrradiance(hitPos, n, -dir) * PI;
        radiance = hit.albedo.rgb / PI * (directIrradiance(hitPos, n, hit.albedo.w) + bounce) + hit.emissive.rgb;
    }
    sRadiance[ray] = radiance;
    sDirection[ray] = dir;
    sDistance[ray] = min(distance, maxDistance) / maxDistance;  // normalized: see probe_common.glsl sampling
    barrier();

    float hysteresis = gi.giParams.z > 0.5 ? 0.0 : gi.probeSpacing.w;
    ivec2 tile = probeTile(probe);

    for (uint t = ray; t < uint(IRRADIANCE_TILE * IRRADIANCE_TILE); t += RAYS) {
        ivec2 local = ivec2(int(t) % IRRADIANCE_TILE, int(t) / IRRADIANCE_TILE);
        vec3 texDir = texelDirection(local, IRRADIANCE_INNER);
        vec3 sum = vec3(0.0);
        float weightSum = 0.0;
        for (uint r = 0u; r < RAYS; ++r) {
            float w = max(dot(texDir, sDirection[r]), 0.0);
            sum += w * sRadiance[r];
            weightSum += w;
        }
        ivec2 texel = tile * IRRADIANCE_TILE + local;
        vec3 fresh = weightSum > 0.0 ? sum / weightSum : vec3(0.0);
        vec3 previous = texelFetch(irradianceAtlas, texel, 0).rgb;
        imageStore(irradianceOut, texel, vec4(mix(fresh, previous, hysteresis), 1.0));
    }

    for (uint t = ray; t < uint(VISIBILITY_TILE * VISIBILITY_TILE); t += RAYS) {
        ivec2 local = ivec2(int(t) % VISIBILITY_TILE, int(t) / VISIBILITY_TILE);
        vec3 texDir = texelDirection(local, VISIBILITY_INNER);
        vec2 sum = vec2(0.0);
        float weightSum = 0.0;
        for (uint r = 0u; r < RAYS; ++r) {
            float w = pow(max(dot(texDir, sDirection[r]), 0.0), 50.0);
            sum += w * vec2(sDistance[r], sDistance[r] * sDistance[r]);
            weightSum += w;
        }
        ivec2 texel = tile * VISIBILITY_TILE + local;
        vec2 fresh = weightSum > 0.0 ? sum / weightSum : vec2(1.0);
        vec2 previous = texelFetch(visibilityAtlas, texel, 0).rg;
        imageStore(visibilityOut, texel, vec4(mix(fresh, previous, hysteresis), 0.0, 0.0));
    }
}
