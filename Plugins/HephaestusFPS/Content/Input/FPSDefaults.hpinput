{
  "version": 1,
  "actions": [
    {
      "name": "Crouch",
      "bindings": [
        { "type": "keyboard", "control": "LEFT_CTRL" },
        { "type": "gamepad_button", "control": "EAST" }
      ]
    },
    {
      "name": "Fire",
      "bindings": [
        { "type": "mouse_button", "control": "LEFT" },
        { "type": "gamepad_button", "control": "RIGHT_BUMPER" }
      ]
    },
    {
      "name": "Aim",
      "bindings": [
        { "type": "mouse_button", "control": "RIGHT" },
        { "type": "gamepad_button", "control": "LEFT_BUMPER" }
      ]
    },
    {
      "name": "Reload",
      "bindings": [
        { "type": "keyboard", "control": "R" },
        { "type": "gamepad_button", "control": "NORTH" }
      ]
    },
    {
      "name": "NextWeapon",
      "bindings": [
        { "type": "keyboard", "control": "Q" },
        { "type": "gamepad_button", "control": "DPAD_RIGHT" }
      ]
    },
    {
      "name": "PreviousWeapon",
      "bindings": [
        { "type": "keyboard", "control": "Z" },
        { "type": "gamepad_button", "control": "DPAD_LEFT" }
      ]
    },
    {
      "name": "Weapon1",
      "bindings": [ { "type": "keyboard", "control": "1" } ]
    },
    {
      "name": "Weapon2",
      "bindings": [ { "type": "keyboard", "control": "2" } ]
    },
    {
      "name": "Weapon3",
      "bindings": [ { "type": "keyboard", "control": "3" } ]
    },
    {
      "name": "Weapon4",
      "bindings": [ { "type": "keyboard", "control": "4" } ]
    },
    {
      "name": "LeanLeft",
      "bindings": [ { "type": "keyboard", "control": "C" } ]
    },
    {
      "name": "LeanRight",
      "bindings": [ { "type": "keyboard", "control": "V" } ]
    },
    {
      "name": "Prone",
      "bindings": [
        { "type": "keyboard", "control": "X" },
        { "type": "gamepad_button", "control": "RIGHT_STICK" }
      ]
    },
    {
      "name": "ThrowFrag",
      "bindings": [
        { "type": "keyboard", "control": "G" },
        { "type": "gamepad_button", "control": "DPAD_UP" }
      ]
    },
    {
      "name": "ThrowSmoke",
      "bindings": [
        { "type": "keyboard", "control": "T" },
        { "type": "gamepad_button", "control": "DPAD_DOWN" }
      ]
    },
    {
      "name": "Pause",
      "bindings": [
        { "type": "keyboard", "control": "ESCAPE" },
        { "type": "keyboard", "control": "F1" },
        { "type": "gamepad_button", "control": "START" }
      ]
    },
    {
      "name": "MenuUp",
      "bindings": [
        { "type": "keyboard", "control": "UP" },
        { "type": "keyboard", "control": "W" },
        { "type": "gamepad_button", "control": "DPAD_UP" }
      ]
    },
    {
      "name": "MenuDown",
      "bindings": [
        { "type": "keyboard", "control": "DOWN" },
        { "type": "keyboard", "control": "S" },
        { "type": "gamepad_button", "control": "DPAD_DOWN" }
      ]
    },
    {
      "name": "MenuLeft",
      "bindings": [
        { "type": "keyboard", "control": "LEFT" },
        { "type": "keyboard", "control": "A" },
        { "type": "gamepad_button", "control": "DPAD_LEFT" }
      ]
    },
    {
      "name": "MenuRight",
      "bindings": [
        { "type": "keyboard", "control": "RIGHT" },
        { "type": "keyboard", "control": "D" },
        { "type": "gamepad_button", "control": "DPAD_RIGHT" }
      ]
    },
    {
      "name": "MenuSelect",
      "bindings": [
        { "type": "keyboard", "control": "ENTER" },
        { "type": "keyboard", "control": "SPACE" },
        { "type": "gamepad_button", "control": "SOUTH" }
      ]
    },
    {
      "name": "MenuBack",
      "bindings": [
        { "type": "keyboard", "control": "ESCAPE" },
        { "type": "keyboard", "control": "BACKSPACE" },
        { "type": "gamepad_button", "control": "EAST" }
      ]
    }
  ],
  "axes": [
    {
      "name": "LookStickX",
      "clamp": true,
      "bindings": [ { "type": "gamepad_axis", "control": "RIGHT_X" } ]
    },
    {
      "name": "LookStickY",
      "clamp": true,
      "bindings": [ { "type": "gamepad_axis", "control": "RIGHT_Y" } ]
    }
  ]
}
