{
  "version": 1,
  "actions": [
    {
      "name": "Crouch",
      "bindings": [
        { "type": "keyboard", "control": "LEFT_CTRL" },
        { "type": "gamepad_button", "control": "EAST" }
      ]
    },
    {
      "name": "Fire",
      "bindings": [
        { "type": "mouse_button", "control": "LEFT" },
        { "type": "gamepad_button", "control": "RIGHT_BUMPER" }
      ]
    },
    {
      "name": "Aim",
      "bindings": [
        { "type": "mouse_button", "control": "RIGHT" },
        { "type": "gamepad_button", "control": "LEFT_BUMPER" }
      ]
    },
    {
      "name": "Reload",
      "bindings": [
        { "type": "keyboard", "control": "R" },
        { "type": "gamepad_button", "control": "NORTH" }
      ]
    },
    {
      "name": "NextWeapon",
      "bindings": [
        { "type": "keyboard", "control": "Q" },
        { "type": "gamepad_button", "control": "DPAD_RIGHT" }
      ]
    },
    {
      "name": "PreviousWeapon",
      "bindings": [
        { "type": "keyboard", "control": "Z" },
        { "type": "gamepad_button", "control": "DPAD_LEFT" }
      ]
    },
    {
      "name": "Weapon1",
      "bindings": [ { "type": "keyboard", "control": "1" } ]
    },
    {
      "name": "Weapon2",
      "bindings": [ { "type": "keyboard", "control": "2" } ]
    },
    {
      "name": "Weapon3",
      "bindings": [ { "type": "keyboard", "control": "3" } ]
    },
    {
      "name": "Weapon4",
      "bindings": [ { "type": "keyboard", "control": "4" } ]
    },
    {
      "name": "Prone",
      "bindings": [
        { "type": "keyboard", "control": "X" },
        { "type": "gamepad_button", "control": "RIGHT_STICK" }
      ]
    },
    {
      "name": "ThrowFrag",
      "bindings": [
        { "type": "keyboard", "control": "G" },
        { "type": "gamepad_button", "control": "DPAD_UP" }
      ]
    },
    {
      "name": "ThrowSmoke",
      "bindings": [
        { "type": "keyboard", "control": "T" },
        { "type": "gamepad_button", "control": "DPAD_DOWN" }
      ]
    }
  ],
  "axes": [
    {
      "name": "LookStickX",
      "clamp": true,
      "bindings": [ { "type": "gamepad_axis", "control": "RIGHT_X" } ]
    },
    {
      "name": "LookStickY",
      "clamp": true,
      "bindings": [ { "type": "gamepad_axis", "control": "RIGHT_Y" } ]
    }
  ]
}
