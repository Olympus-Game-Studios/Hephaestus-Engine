                            "textAlignment": "Center"
                        },
                        "style": {
                            "fontSize": 14,
                            "textColor": [0.75, 0.78, 0.85, 1.0]
                        }
                    },
                    {
                        "type": "VerticalBox",
                        "id": "menu_buttons",
                        "properties": {
                            "position": [0, 92],
                            "size": [504, 300],
                            "spacing": 16,
                            "childHAlignment": "Center"
                        },
                        "children": [
                            {
                                "type": "Button",
                                "id": "btn_play",
                                "properties": {
                                    "text": "Play",
                                    "size": [300, 56]
                                },
                                "normalStyle": {
                                    "backgroundColor": [0.2, 0.55, 0.85, 1.0],
                                    "cornerRadius": 10,
                                    "textColor": [1, 1, 1, 1],
                                    "fontSize": 20,
                                    "fontBold": true
                                },
                                "hoveredStyle": {
                                    "backgroundColor": [0.3, 0.65, 0.95, 1.0],
                                    "cornerRadius": 10,
                                    "borderColor": [1, 1, 1, 0.3],
                                    "borderWidth": 2
                                },
                                "pressedStyle": {
                                    "backgroundColor": [0.15, 0.4, 0.65, 1.0],
                                    "cornerRadius": 10
                                }
                            },
                            {
                                "type": "Button",
                                "id": "btn_settings",
                                "properties": {
                                    "text": "Settings",
                                    "size": [300, 56]
                                },
                                "normalStyle": {
                                    "backgroundColor": [0.25, 0.25, 0.3, 1.0],
                                    "cornerRadius": 10,
                                    "textColor": [0.9, 0.9, 0.95, 1.0],
                                    "fontSize": 20
                                },
                                "hoveredStyle": {
                                    "backgroundColor": [0.35, 0.35, 0.4, 1.0],
                                    "cornerRadius": 10,
                                    "borderColor": [1, 1, 1, 0.2],
                                    "borderWidth": 1
