                    "size": [120, 60],
                    "anchor": "TopLeft"
                },
                "style": {
                    "backgroundColor": [0.2, 0.3, 0.4, 0.8]
                }
            },
            {
                "type": "Panel",
                "id": "corner_tr",
                "properties": {
                    "size": [120, 60],
                    "anchor": "TopRight"
                },
                "style": {
                    "backgroundColor": [0.4, 0.3, 0.2, 0.8]
                }
            },
            {
                "type": "Panel",
                "id": "corner_bl",
                "properties": {
                    "size": [120, 60],
                    "anchor": "BottomLeft"
                },
                "style": {
                    "backgroundColor": [0.2, 0.4, 0.3, 0.8]
                }
            },
            {
                "type": "Panel",
                "id": "corner_br",
                "properties": {
                    "size": [120, 60],
                    "anchor": "BottomRight"
                },
                "style": {
                    "backgroundColor": [0.4, 0.2, 0.3, 0.8]
                }
            },
            {
                "type": "Panel",
                "id": "center_panel",
                "properties": {
                    "size": [560, 640],
                    "anchor": "Center",
                    "padding": [28, 24, 28, 24]
                },
                "style": {
                    "backgroundColor": [0.12, 0.13, 0.16, 0.95],
                    "cornerRadius": 12,
                    "borderColor": [1, 1, 1, 0.12],
                    "borderWidth": 1
                },
                "children": [
                    {
                        "type": "Text",
                        "id": "title",
                        "properties": {
                            "text": "Hephaestus Runtime UI",
                            "size": [504, 52],
                            "textAlignment": "Center"
                        },
                        "style": {
                            "fontSize": 30,
                            "fontBold": true,
                            "textColor": [0.92, 0.78, 0.3, 1.0],
                            "textShadow": true,
                            "textShadowColor": [0, 0, 0, 0.7],
                            "textShadowOffset": [2, 2]
                        }
                    },
                    {
                        "type": "Text",
                        "id": "subtitle",
                        "properties": {
                            "text": "Vulkan packaged runtime overlay (Stage 8A)",
