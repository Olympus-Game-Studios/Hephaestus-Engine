                                "hoveredStyle": {
                                    "backgroundColor": [0.75, 0.2, 0.2, 1.0],
                                    "cornerRadius": 10,
                                    "borderColor": [1, 0.4, 0.4, 0.4],
                                    "borderWidth": 1
                                }
                            }
                        ]
                    },
                    {
                        "type": "HorizontalBox",
                        "id": "image_row",
                        "properties": {
                            "position": [0, 404],
                            "size": [504, 140],
                            "spacing": 16
                        },
                        "children": [
                            {
                                "type": "Image",
                                "id": "icon",
                                "properties": {
                                    "size": [140, 140],
                                    "imageId": "assets/textures/light_bulb.png",
                                    "imageScaleMode": "Fit"
                                }
                            },
                            {
                                "type": "Text",
                                "id": "body",
                                "properties": {
                                    "text": "Body text drawn by the packaged Vulkan backend. Anchors, nested layouts, clipping, opacity, images, text shadows and buttons are all exercised on this screen.",
                                    "wordWrap": true
                                },
                                "style": {
                                    "fontSize": 13,
                                    "textColor": [0.85, 0.85, 0.9, 0.9]
                                }
                            }
                        ]
                    },
                    {
                        "type": "Panel",
                        "id": "semi_transparent",
                        "properties": {
                            "position": [0, 556],
                            "size": [504, 44],
                            "opacity": 0.5
                        },
                        "style": {
                            "backgroundColor": [0.3, 0.6, 0.9, 1.0],
