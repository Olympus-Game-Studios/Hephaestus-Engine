{
    "version": 1,
    "controller": "HUIRuntimeTest.lua",
    "root": {
        "type": "Panel",
        "id": "root",
        "properties": {
            "anchor": "Stretch"
        },
        "style": {
            "backgroundColor": [0.05, 0.06, 0.08, 0.96]
        },
        "children": [
            {
                "type": "Panel",
                "id": "corner_tl",
                "properties": {
