{
  "version": 1,
  "actions": [
    {
      "name": "Jump",
      "bindings": [
        {
          "type": "keyboard",
          "control": "SPACE"
        },
        {
          "type": "gamepad_button",
          "control": "SOUTH"
        }
      ]
    },
    {
      "name": "Interact",
      "bindings": [
        {
          "type": "keyboard",
          "control": "E"
        },
        {
          "type": "gamepad_button",
          "control": "WEST"
        }
      ]
    },
    {
      "name": "Sprint",
      "bindings": [
        {
          "type": "keyboard",
          "control": "LEFT_SHIFT"
        },
        {
          "type": "gamepad_button",
          "control": "LEFT_STICK"
        }
      ]
    }
  ],
  "axes": [
    {
      "name": "MoveForward",
      "clamp": true,
      "bindings": [
        {
          "type": "keyboard",
          "control": "W"
        },
        {
          "type": "keyboard",
          "control": "S",
          "scale": -1.0
        },
        {
          "type": "gamepad_axis",
          "control": "LEFT_Y",
          "scale": -1.0
        }
      ]
    },
    {
      "name": "MoveRight",
      "clamp": true,
      "bindings": [
        {
          "type": "keyboard",
          "control": "D"
        },
        {
          "type": "keyboard",
          "control": "A",
          "scale": -1.0
        },
        {
          "type": "gamepad_axis",
          "control": "LEFT_X"
        }
      ]
    },
    {
      "name": "LookX",
      "clamp": false,
      "bindings": [
        {
          "type": "mouse_delta",
          "control": "X"
        },
        {
          "type": "gamepad_axis",
          "control": "RIGHT_X"
        }
      ]
    },
    {
      "name": "LookY",
      "clamp": false,
      "bindings": [
        {
          "type": "mouse_delta",
          "control": "Y"
        },
        {
          "type": "gamepad_axis",
          "control": "RIGHT_Y"
        }
      ]
    }
  ]
}
